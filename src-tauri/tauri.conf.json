{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "地球桌面",
  "version": "1.2.8",
  "identifier": "dev.earthdesk.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "wallpaper",
        "url": "wallpaper.html",
        "width": 1920,
        "height": 1080,
        "x": 0,
        "y": 0,
        "transparent": false,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": false,
        "focus": false,
        "visible": false
      },
      {
        "label": "weather",
        "url": "index.html",
        "width": 440,
        "height": 440,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": false,
        "visible": false
      },
      {
        "label": "perf",
        "url": "perf.html",
        "width": 440,
        "height": 440,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": false,
        "visible": false
      },
      {
        "label": "guides",
        "url": "guides.html",
        "width": 800,
        "height": 600,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": false,
        "visible": false
      },
      {
        "label": "capture",
        "url": "capture.html",
        "title": "截图",
        "width": 800,
        "height": 600,
        "x": 0,
        "y": 0,
        "transparent": false,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": false,
        "visible": false
      },
      {
        "label": "clippanel",
        "url": "clip.html?mode=panel",
        "title": "剪贴板历史",
        "width": 380,
        "height": 520,
        "transparent": false,
        "decorations": false,
        "shadow": true,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": false,
        "visible": false
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "地球桌面 设置",
        "width": 740,
        "height": 880,
        "minWidth": 560,
        "minHeight": 420,
        "center": true,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "skipTaskbar": false,
        "alwaysOnTop": false,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "publisher": "EarthDesk",
    "copyright": "MIT License",
    "shortDescription": "实时地球壁纸 + 天气 + 硬件监控",
    "resources": {
      "vendor/sensors/": "sensors/",
      "vendor/ime/": "ime/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installMode": "perMachine",
        "installerHooks": "windows/hooks.nsh",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "mainBinaryName": "EarthDesk"
}